package ${classPackageName};

<#list imports as import>
import ${import};
</#list>

<#if lombok>
@Data
@Builder
@NoArgsConstructor
@AllArgsConstructor
</#if>
<#if openApi>
@Schema(description = "${description}")
</#if>
public class ${dtoClass} {

<#list fields as f>
<#list f.annotations as a>
    ${a}
</#list>
<#if openApi && f.example??>
    @Schema(example = "${f.example}")
</#if>
    private ${f.type} ${f.name};

</#list>
<#if !lombok>
    public ${dtoClass}() {
    }

<#if fields?size gt 0>
    public ${dtoClass}(<#list fields as f>${f.type} ${f.name}<#sep>, </#sep></#list>) {
<#list fields as f>
        this.${f.name} = ${f.name};
</#list>
    }

</#if>
<#list fields as f>
    public ${f.type} ${f.getter}() {
        return ${f.name};
    }

    public void ${f.setter}(${f.type} ${f.name}) {
        this.${f.name} = ${f.name};
    }

</#list>
</#if>
${customRegion}
}
