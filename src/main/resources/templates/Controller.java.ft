<#function R t><#return wrap?then("ApiResult<" + t + ">", t)></#function>
<#function B e><#return wrap?then("ApiResult.success(" + e + ")", e)></#function>
package ${classPackageName};

import ${pkg.service}.${className}Service;
import ${pkg.dtoReq}.${className}Request;
import ${pkg.dtoResp}.${className}Response;
<#if pagination>
import ${pkg.dtoReq}.${className}Filter;
import ${pkg.dtoRoot}.PageResponse;
</#if>
<#if wrap>
import ${pkg.dtoRoot}.ApiResult;
</#if>
<#if openApi>
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.responses.ApiResponse;
import io.swagger.v3.oas.annotations.responses.ApiResponses;
import io.swagger.v3.oas.annotations.tags.Tag;
<#if parameterObject>
import org.springdoc.core.annotations.ParameterObject;
</#if>
</#if>
import ${validationPkg}.Valid;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
<#if lombok>
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
<#else>
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
</#if>
<#if !pagination>

import java.util.List;
</#if>

<#if lombok>
@Slf4j
@RequiredArgsConstructor
</#if>
@RestController
<#if versionHeader??>
@RequestMapping(value = "${basePath}", headers = "${versionHeader}=${apiVersion}")
<#else>
@RequestMapping("${basePath}")
</#if>
<#if openApi>
@Tag(name = "${className}", description = "Operations on ${className}")
</#if>
public class ${className}Controller {

<#if !lombok>
    private static final Logger log = LoggerFactory.getLogger(${className}Controller.class);

</#if>
    private final ${className}Service service;

<#if !lombok>
    public ${className}Controller(${className}Service service) {
        this.service = service;
    }

</#if>
<#if openApi>
    @Operation(summary = "Create a ${className}")
    @ApiResponses({
            @ApiResponse(responseCode = "201", description = "${className} created"),
            @ApiResponse(responseCode = "400", description = "Validation failed")
    })
</#if>
    @PostMapping
    public ResponseEntity<${R(className + "Response")}> create(@Valid @RequestBody ${className}Request request) {
        log.info("REST request to create ${className} : {}", request);
        ${className}Response response = service.save(request);
        return ResponseEntity.status(HttpStatus.CREATED).body(${B("response")});
    }

<#if openApi>
    @Operation(summary = "Get a ${className} by id")
    @ApiResponses({
            @ApiResponse(responseCode = "200", description = "${className} found"),
            @ApiResponse(responseCode = "404", description = "${className} not found")
    })
</#if>
    @GetMapping("/{id}")
<#if wrap>
    public ResponseEntity<${R(className + "Response")}> findById(@PathVariable ${idType} id) {
        log.info("REST request to get ${className} by id : {}", id);
        return ResponseEntity.ok(${B("service.findById(id)")});
    }
<#else>
    public ResponseEntity<${className}Response> findById(@PathVariable ${idType} id) {
        log.info("REST request to get ${className} by id : {}", id);
        return service.findById(id)
                .map(ResponseEntity::ok)
                .orElseGet(() -> ResponseEntity.notFound().build());
    }
</#if>

<#if openApi>
    @Operation(summary = "List ${className}s")
</#if>
    @GetMapping
<#if pagination>
    public ResponseEntity<${R("PageResponse<" + className + "Response>")}> findAll(
            <#if parameterObject>@ParameterObject </#if>@ModelAttribute ${className}Filter filter,
            @RequestParam(defaultValue = "0") int page,
            @RequestParam(defaultValue = "20") int size,
            @RequestParam(required = false) String sort
    ) {
        log.info("REST request to search ${className}s : {}, page={}, size={}, sort={}", filter, page, size, sort);
        return ResponseEntity.ok(${B("service.findAll(filter, page, size, sort)")});
    }
<#else>
    public ResponseEntity<${R("List<" + className + "Response>")}> findAll() {
        log.info("REST request to get all ${className}s");
        return ResponseEntity.ok(${B("service.findAll()")});
    }
</#if>

<#if openApi>
    @Operation(summary = "Update a ${className}")
    @ApiResponses({
            @ApiResponse(responseCode = "200", description = "${className} updated"),
            @ApiResponse(responseCode = "400", description = "Validation failed"),
            @ApiResponse(responseCode = "404", description = "${className} not found")
    })
</#if>
    @PutMapping("/{id}")
    public ResponseEntity<${R(className + "Response")}> update(
            @PathVariable ${idType} id,
            @Valid @RequestBody ${className}Request request
    ) {
        log.info("REST request to update ${className} : {}, {}", id, request);
        ${className}Response response = service.update(id, request);
        return ResponseEntity.ok(${B("response")});
    }

<#if openApi>
    @Operation(summary = "Delete a ${className}")
    @ApiResponses({
            @ApiResponse(responseCode = "204", description = "${className} deleted"),
            @ApiResponse(responseCode = "404", description = "${className} not found")
    })
</#if>
    @DeleteMapping("/{id}")
    public ResponseEntity<Void> delete(@PathVariable ${idType} id) {
        log.info("REST request to delete ${className} by id : {}", id);
        service.delete(id);
        return ResponseEntity.noContent().build();
    }

${customRegion}
}
